<Window x:Class="CsvRegression.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CsvRegression"
        xmlns:oxy="http://oxyplot.org/wpf"
        mc:Ignorable="d"
        Title="CSV Regression" Height="450" Width="800">
    <Window.InputBindings>
        <KeyBinding Key="Delete" Command="{Binding RemoveSelectedRowCommand}"/>
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_Open CSV..." Command="{Binding OpenCsvCommand}"/>
                <MenuItem Header="_Exit" Click="ExitMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Remove Selected Row" Command="{Binding RemoveSelectedRowCommand}"/>
            </MenuItem>
            <MenuItem Header="_Help"/>
        </Menu>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="8">
                <TextBlock Text="X:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox Width="120" ItemsSource="{Binding NumericColumns}" SelectedItem="{Binding SelectedXColumn}"
                          IsEnabled="{Binding HasNumericColumns}"/>
                <TextBlock Text="Y:" VerticalAlignment="Center" Margin="12,0,4,0"/>
                <ComboBox Width="120" ItemsSource="{Binding NumericColumns}" SelectedItem="{Binding SelectedYColumn}"
                          IsEnabled="{Binding HasNumericColumns}"/>
            </StackPanel>

            <DataGrid Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                      AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False"/>

            <oxy:PlotView Grid.Row="1" Grid.Column="1" Model="{Binding PlotModel}"/>
        </Grid>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
